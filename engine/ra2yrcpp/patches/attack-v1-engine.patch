+#pragma once
+#include <cstdint>
+
+namespace ra2 {
+namespace attack_policy {
+struct Target {
+  std::uint32_t native_id;
+  std::uint32_t house;
+  int type;
+  bool live;
+  bool visible;
+  bool hostile;
+  bool transforming;
+};
+inline bool eligible(const Target& t) {
+  return t.native_id && t.house && (t.type == 1 || t.type == 6) &&
+         t.live && t.visible && t.hostile && !t.transforming;
+}
+inline bool matches(const Target& t, std::uint32_t id,
+                    std::uint32_t house, int type) {
+  return eligible(t) && id && house && t.native_id == id &&
+         t.house == house && t.type == type;
+}
+}  // namespace attack_policy
+}  // namespace ra2
