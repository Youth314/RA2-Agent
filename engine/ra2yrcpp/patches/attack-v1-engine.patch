+static void parse_actual_targets(ra2yrproto::ra2yr::GameState* G,
+                                 ra2::abi::ABIGameMD* abi) {
+  namespace policy = ra2::target_observation;
+  auto* player = HouseClass::CurrentPlayer.get();
+  const auto house = reinterpret_cast<u32>(player);
+  std::unordered_map<u32, TechnoClass*> live;
+  for (auto* object : ra2::abi::DVCIterator(TechnoClass::Array.get())) {
+    if (object) {
+      live.emplace(reinterpret_cast<u32>(object), object);
+    }
+  }
+  policy::Members members;
+  for (const auto& observed : G->objects()) {
+    auto found = live.find(observed.pointer_self());
+    if (found == live.end()) {
+      continue;
+    }
+    auto* object = found->second;
+    const auto type = static_cast<int>(ra2::abi::AbstractClass_WhatAmI::call(abi, object));
+    const bool eligible = object->IsAlive && object->Health > 0 &&
+                          object->IsOnMap && !object->InLimbo &&
+                          policy::techno_type(type) && type == observed.object_type();
+    const bool own = player && object->Owner == player;
+    // Only own eligible actors' Target is read. Foreign actor targets stay hidden.
+    members.emplace(found->first, policy::Member{
+        found->first, object->UniqueID, reinterpret_cast<u32>(object->Owner),
+        type, eligible, !own && eligible && ra2::attack_target::foreign_visible(object),
+        own && eligible ? reinterpret_cast<u32>(object->Target) : 0});
+  }
+  for (auto& observed : *G->mutable_objects()) {
+    observed.clear_actual_target();
+    observed.clear_order_target_native_id();
+    auto live_target = live.find(observed.pointer_self());
+    if (live_target != live.end()) {
+      const auto candidate = ra2::attack_target::snapshot(live_target->second, player, abi);
+      if (candidate.type == observed.object_type() && ra2::attack_policy::eligible(candidate)) {
+        observed.set_order_target_native_id(candidate.native_id);
+      }
+    }
+    auto found = members.find(observed.pointer_self());
+    if (found == members.end()) {
+      continue;
+    }
+    auto result = policy::resolve(found->second, house, members);
+    if (result.status == policy::Status::not_provided) {
+      continue;
+    }
+    auto* target = observed.mutable_actual_target();
+    target->Clear();
+    target->set_status(static_cast<ra2yrproto::ra2yr::ActualTargetObservation_Status>(result.status));
+    if (result.target) {
+      TargetClass reference;
+      const u32 native_id = result.target->native_id;
+      static_assert(sizeof(reference.m_ID) == sizeof(native_id), "TargetClass ID width");
+      std::memcpy(&reference.m_ID, &native_id, sizeof(native_id));
+      reference.m_RTTI = static_cast<unsigned char>(AbstractType::Abstract);
+      parse_TargetClass(reference, target->mutable_reference());
+      target->set_object_type(static_cast<ra2yrproto::ra2yr::AbstractType>(result.target->object_type));
+      target->set_object_pointer(result.target->pointer);
+    }
+  }
+}
+
 void ra2::parse_Objects(ra2yrproto::ra2yr::GameState* G,
                         ra2::abi::ABIGameMD* abi) {
   auto* H = G->mutable_objects();
   (void)ra2yrcpp::protocol::truncate(
       H, parse_object_array(abi, TechnoClass::Array.get(), H, 0));
+  parse_actual_targets(G, abi);
 }
 
