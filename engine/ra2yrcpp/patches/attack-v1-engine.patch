+#pragma once
+#include "ra2/abi.hpp"
+#include "ra2/attack_policy.hpp"
+#include "ra2/target_observation.hpp"
+#include "ra2/yrpp_export.hpp"
+#include <ScenarioClass.h>
+#include <GameModeOptionsClass.h>
+#include <cstddef>
+
+// Additional relation fields, locked to YRpp 173447cf / MinGW i686.
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Winvalid-offsetof"
+static_assert(sizeof(void*) == 4, "Attack requires i686");
+static_assert(offsetof(HouseClass, Type) == 0x34, "House Type layout");
+static_assert(offsetof(HouseTypeClass, MultiplayPassive) == 0x1A6, "Neutral flag layout");
+#pragma GCC diagnostic pop
+
+namespace ra2 {
+namespace attack_target {
+// Same FogOfWar=No, shroud, cloak and disguise gate as Target v1.
+inline bool foreign_visible(const TechnoClass* object) {
+  auto* scenario = ScenarioClass::Instance.get();
+  auto* rules = RulesClass::Instance.get();
+  auto* map = MapClass::Instance.get();
+  if (!scenario || !rules || !map) return false;
+  const bool fog = scenario->SpecialFlags.FogOfWar || rules->FogOfWar ||
+                   GameModeOptionsClass::Instance->FogOfWar;
+  const auto& location = object->Location;
+  if (location.X < 0 || location.Y < 0 || location.X >= 512 * 256 ||
+      location.Y >= 512 * 256) return false;
+  const auto cell = CellClass::Coord2Cell(location);
+  const auto& bounds = map->MapCoordBounds;
+  if (cell.X < bounds.Left || cell.Y < bounds.Top ||
+      cell.X > bounds.Right || cell.Y > bounds.Bottom) return false;
+  auto* value = map->TryGetCellAt(cell);
+  if (!value) return false;
+  return target_observation::foreign_visible(
+      true, fog, (static_cast<int>(value->AltFlags) & 0x8) == 0,
+      static_cast<int>(object->CloakState),
+      object->Disguised || object->Disguise || object->DisguisedAsHouse);
+}
+
+template <typename T>
+inline bool member(T* object, DynamicVectorClass<T*>* array) {
+  if (!object || !array) return false;
+  for (auto* value : abi::DVCIterator(array)) {
+    if (value == object) return true;
+  }
+  return false;
+}
+
+inline bool hostile(HouseClass* player, HouseClass* owner, abi::ABIGameMD* abi) {
+  // Compare array members before reading owner or owner->Type. Never invoke a
+  // MinGW virtual method against game MSVC objects.
+  if (owner == player || !member(player, HouseClass::Array.get()) ||
+      !member(owner, HouseClass::Array.get()) ||
+      !member(player->Type, HouseTypeClass::Array.get()) ||
+      !member(owner->Type, HouseTypeClass::Array.get()) ||
+      player->Type->MultiplayPassive || owner->Type->MultiplayPassive ||
+      player->Defeated || player->IsWinner || player->IsLoser || owner->Defeated) {
+    return false;
+  }
+  return !ra2::abi::HouseClass_IsAlliedWith::call(abi, player, owner) &&
+         !ra2::abi::HouseClass_IsAlliedWith::call(abi, owner, player);
+}
+
+inline attack_policy::Target snapshot(TechnoClass* object, HouseClass* player,
+                                      abi::ABIGameMD* abi) {
+  const auto type = static_cast<int>(ra2::abi::AbstractClass_WhatAmI::call(abi, object));
+  const bool supported = type == 1 || type == 6;
+  bool transforming = false;
+  if (type == 1) {
+    auto* unit = static_cast<UnitClass*>(object);
+    transforming = unit->IsDeploying || unit->Deploying || unit->Undeploying;
+  }
+  const bool live = supported && object->IsAlive && object->IsOnMap &&
+                    !object->InLimbo && object->Health > 0;
+  return {object->UniqueID, reinterpret_cast<u32>(object->Owner), type,
+          live, live && foreign_visible(object),
+          live && hostile(player, object->Owner, abi), transforming};
+}
+}  // namespace attack_target
+}  // namespace ra2
