diff --git a/src/ra2/target_observation.hpp b/src/ra2/target_observation.hpp
new file mode 100644
index 0000000..1f375bd
--- /dev/null
+++ b/src/ra2/target_observation.hpp
@@ -0,0 +1,49 @@
+#pragma once
+
+#include <cstdint>
+#include <unordered_map>
+
+namespace ra2 {
+namespace target_observation {
+// Plain snapshots: resolution never dereferences an untrusted Target address.
+struct Member {
+  std::uint32_t pointer;
+  std::uint32_t native_id;
+  std::uint32_t house;
+  int object_type;
+  bool eligible;
+  bool foreign_visible;
+  std::uint32_t target;
+};
+using Members = std::unordered_map<std::uint32_t, Member>;
+enum class Status { not_provided = 0, unobservable = 1, none = 2, object = 3 };
+struct Result {
+  Status status;
+  const Member* target;
+};
+inline bool techno_type(int type) {
+  return type == 1 || type == 2 || type == 6 || type == 15;
+}
+inline bool foreign_visible(bool context_known, bool fog, bool shrouded,
+                            int cloak, bool disguised) {
+  return context_known && !fog && !shrouded && cloak == 0 && !disguised;
+}
+inline Result resolve(const Member& actor, std::uint32_t player,
+                      const Members& members) {
+  if (!player || actor.house != player || !actor.eligible ||
+      !techno_type(actor.object_type)) {
+    return {Status::not_provided, nullptr};
+  }
+  if (!actor.target) {
+    return {Status::none, nullptr};
+  }
+  auto found = members.find(actor.target);
+  if (found == members.end() || !found->second.eligible ||
+      !techno_type(found->second.object_type) ||
+      (found->second.house != player && !found->second.foreign_visible)) {
+    return {Status::unobservable, nullptr};
+  }
+  return {Status::object, &found->second};
+}
+}  // namespace target_observation
+}  // namespace ra2
